# FastAPI — config
# Copy this file to .env and fill in your values.
# Prefix: GDP_

# --- App ---
GDP_APP_NAME=GeneralDataPlatform
GDP_APP_VERSION=0.1.0
GDP_DEBUG=true

# --- Database ---
GDP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gdp
GDP_DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/gdp
GDP_DATABASE_ECHO=false
GDP_DATABASE_POOL_SIZE=10
GDP_DATABASE_MAX_OVERFLOW=20

# --- Redis ---
GDP_REDIS_URL=redis://localhost:6379/0

# --- JWT ---
GDP_JWT_SECRET=CHANGE-ME-IN-PRODUCTION
GDP_JWT_ALGORITHM=HS256
GDP_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
GDP_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Encryption (Fernet) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GDP_ENCRYPTION_KEY=

# --- Celery ---
GDP_CELERY_BROKER_URL=redis://localhost:6379/1
GDP_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS ---
GDP_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Storage ---
GDP_STORAGE_LOCAL_ROOT=./storage/uploads
